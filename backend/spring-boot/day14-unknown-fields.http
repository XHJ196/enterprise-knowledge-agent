# Day 14：拒绝未知 JSON 字段的真实 HTTP 验收。
# 前置条件：保存配置并启动最新 Spring Boot，加载 fail-on-unknown-properties=true。
# 当前创建请求仅允许 name、description；本文件分别附加 role、createdBy、lifecycle。
# 在 IDEA HTTP Client 中依次运行 1–3，也可对本文件使用 Run All。
# 每条请求均预期 422 / VALIDATION_ERROR，并检查固定文案、data 和 requestId。

@baseUrl = http://localhost:8080

### 1. 创建请求包含未知字段 role：422 / VALIDATION_ERROR
POST {{baseUrl}}/api/v1/knowledge-bases
Content-Type: application/json
Accept: application/json

{
  "name": "Day14 Unknown Field",
  "description": "未知字段验收",
  "role": "ADMIN"
}

> {%
    client.test("未知字段 role 返回统一 422 响应", function () {
        client.assert(response.status === 422, "HTTP 应为 422");
        client.assert(response.body.code === "VALIDATION_ERROR", "code 应为 VALIDATION_ERROR");
        client.assert(response.body.message === "请求参数校验失败", "应返回固定校验错误文案");
        client.assert(response.body.data === null, "错误响应 data 应为 null");
        const requestId = response.body.requestId;
        client.assert(typeof requestId === "string" && requestId.trim().length > 0, "requestId 应非空");
        client.assert(requestId === response.headers.valueOf("X-Request-Id"), "JSON 与响应头的 requestId 应一致");
    });
%}

### 2. 创建请求包含未知字段 createdBy：422 / VALIDATION_ERROR
POST {{baseUrl}}/api/v1/knowledge-bases
Content-Type: application/json
Accept: application/json

{
  "name": "Day14 Unknown Field",
  "description": "未知字段验收",
  "createdBy": "10000000-0000-4000-8000-000000000099"
}

> {%
    client.test("未知字段 createdBy 返回统一 422 响应", function () {
        client.assert(response.status === 422, "HTTP 应为 422");
        client.assert(response.body.code === "VALIDATION_ERROR", "code 应为 VALIDATION_ERROR");
        client.assert(response.body.message === "请求参数校验失败", "应返回固定校验错误文案");
        client.assert(response.body.data === null, "错误响应 data 应为 null");
        const requestId = response.body.requestId;
        client.assert(typeof requestId === "string" && requestId.trim().length > 0, "requestId 应非空");
        client.assert(requestId === response.headers.valueOf("X-Request-Id"), "JSON 与响应头的 requestId 应一致");
    });
%}

### 3. 创建请求包含未知字段 lifecycle：422 / VALIDATION_ERROR
POST {{baseUrl}}/api/v1/knowledge-bases
Content-Type: application/json
Accept: application/json

{
  "name": "Day14 Unknown Field",
  "description": "未知字段验收",
  "lifecycle": "DELETED"
}

> {%
    client.test("未知字段 lifecycle 返回统一 422 响应", function () {
        client.assert(response.status === 422, "HTTP 应为 422");
        client.assert(response.body.code === "VALIDATION_ERROR", "code 应为 VALIDATION_ERROR");
        client.assert(response.body.message === "请求参数校验失败", "应返回固定校验错误文案");
        client.assert(response.body.data === null, "错误响应 data 应为 null");
        const requestId = response.body.requestId;
        client.assert(typeof requestId === "string" && requestId.trim().length > 0, "requestId 应非空");
        client.assert(requestId === response.headers.valueOf("X-Request-Id"), "JSON 与响应头的 requestId 应一致");
    });
%}
