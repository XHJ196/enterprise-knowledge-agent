### 12. GET 携带非空 JSON 请求体：400
GET {{baseUrl}}/api/v1/knowledge-bases?page=1&pageSize=20
Content-Type: application/json
Accept: application/json

{}

> {%
    client.test("GET 非空请求体返回统一 400 响应", function () {
        client.assert(response.status === 400, "应返回 400");
        client.assert(response.body.code === "INVALID_REQUEST_BODY", "错误码应为 INVALID_REQUEST_BODY");
        client.assert(response.body.message === "该接口不接受请求体", "应明确拒绝请求体");
        client.assert(response.body.data === null, "错误响应 data 应为 null");
        const requestId = response.body.requestId;
        client.assert(typeof requestId === "string" && requestId.length > 0, "requestId 应非空");
        client.assert(requestId === response.headers.valueOf("X-Request-Id"), "requestId 应与响应头一致");
    });
%}
