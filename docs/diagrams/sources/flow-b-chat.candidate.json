{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "流程 B · 单知识库问答、引用与取消（设计时序）",
    "output": "diagrams/flow-b-chat.html",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "web",
      "type": "frontend",
      "label": "前端",
      "sublabel": "提问 · 回答 · 引用"
    },
    {
      "id": "spring",
      "type": "backend",
      "label": "Spring Boot",
      "sublabel": "鉴权 · 会话 · SSE"
    },
    {
      "id": "fast",
      "type": "backend",
      "label": "FastAPI",
      "sublabel": "Retrieval / 生成"
    },
    {
      "id": "db",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "会话 / 向量 / 版本"
    },
    {
      "id": "models",
      "type": "external",
      "label": "模型 API",
      "sublabel": "Embedding / LLM"
    },
    {
      "id": "files",
      "type": "database",
      "label": "文件存储",
      "sublabel": "原文件下载"
    }
  ],
  "segments": [
    {
      "from": 155,
      "to": 440,
      "label": "B01—B03 Spring 保存问题，建立受限生成执行"
    },
    {
      "from": 500,
      "to": 950,
      "label": "B04—B06 先限定知识库和发布版本，再检索与生成"
    },
    {
      "from": 1010,
      "to": 1690,
      "label": "B07—B08 两层流式传输，Spring 保存后确认完成"
    },
    {
      "from": 1750,
      "to": 2225,
      "label": "B09 打开来源与下载时再次校验权限和版本"
    },
    {
      "from": 2285,
      "to": 2700,
      "label": "替代分支：主动停止、撤权或超时，与正常完成互斥"
    }
  ],
  "messages": [
    {
      "id": "b-question",
      "from": "web",
      "to": "spring",
      "y": 175,
      "label": "01 POST 提交问题",
      "variant": "emphasis",
      "note": "单一知识库会话；前端 1 秒内显示等待"
    },
    {
      "id": "b-auth",
      "from": "spring",
      "to": "db",
      "y": 275,
      "label": "02 SQL 鉴权与保存",
      "variant": "security",
      "note": "校验 owner、KB 授权、长度、单生成；保存问题/run，取最近 10 轮"
    },
    {
      "id": "b-scope",
      "from": "spring",
      "to": "fast",
      "y": 375,
      "label": "03 HTTP 生成请求",
      "variant": "emphasis",
      "note": "runId + 签名 scope + 上下文 + deadline；返回 SSE 流"
    },
    {
      "id": "b-query-embed",
      "from": "fast",
      "to": "models",
      "y": 520,
      "label": "04 HTTPS 查询向量",
      "variant": "default",
      "note": "上下文只用于理解问题；查询与文档用同一 Embedding 模型"
    },
    {
      "id": "b-query-vec",
      "from": "models",
      "to": "fast",
      "y": 620,
      "label": "查询向量",
      "variant": "return"
    },
    {
      "id": "b-retrieve",
      "from": "fast",
      "to": "db",
      "y": 685,
      "label": "05 SQL 受限检索",
      "variant": "security",
      "note": "WHERE kbId + 当前已发布版本/attempt + modelId，再按向量距离排序"
    },
    {
      "id": "b-evidence",
      "from": "db",
      "to": "fast",
      "y": 785,
      "label": "片段 / 页码 / 版本",
      "variant": "return",
      "note": "构造 evidenceId 清单；无依据、部分依据与冲突遵循 PRD"
    },
    {
      "id": "b-llm",
      "from": "fast",
      "to": "models",
      "y": 885,
      "label": "06 HTTPS 流式生成",
      "variant": "emphasis",
      "note": "输入问题及证据；未知引用 ID 不得成为真实来源"
    },
    {
      "id": "b-model-stream",
      "from": "models",
      "to": "fast",
      "y": 1030,
      "label": "07 模型内容流",
      "variant": "return"
    },
    {
      "id": "b-internal-stream",
      "from": "fast",
      "to": "spring",
      "y": 1095,
      "label": "08 HTTP SSE 事件",
      "variant": "emphasis",
      "note": "delta / citations / done，携带 runId 与 seq"
    },
    {
      "id": "b-check-persist",
      "from": "spring",
      "to": "db",
      "y": 1195,
      "label": "09 校验并保存片段",
      "variant": "security",
      "note": "每批检查 run、当前授权及来源；失效则不继续转发"
    },
    {
      "id": "b-ui-stream",
      "from": "spring",
      "to": "web",
      "y": 1295,
      "label": "10 HTTP SSE 逐步展示",
      "variant": "emphasis"
    },
    {
      "id": "b-citations",
      "from": "fast",
      "to": "spring",
      "y": 1360,
      "label": "11 引用清单与 done",
      "variant": "return",
      "note": "Fast 的 done 只代表计算完成，不代表会话已保存"
    },
    {
      "id": "b-final-save",
      "from": "spring",
      "to": "db",
      "y": 1460,
      "label": "12 SQL 核验与最终保存",
      "variant": "default",
      "note": "核对真实 chunk/页码/版本，正文与引用一起完成"
    },
    {
      "id": "b-final-commit",
      "from": "db",
      "to": "spring",
      "label": "事务提交成功",
      "variant": "return",
      "y": 1560
    },
    {
      "id": "b-done",
      "from": "spring",
      "to": "web",
      "y": 1625,
      "label": "13 citations + done",
      "variant": "return",
      "note": "持久化成功后才显示完整回答和可点击引用"
    },
    {
      "id": "b-click",
      "from": "web",
      "to": "spring",
      "y": 1770,
      "label": "14 GET 来源引用",
      "variant": "default"
    },
    {
      "id": "b-cite-auth",
      "from": "spring",
      "to": "db",
      "y": 1835,
      "label": "SQL 当前权限与版本",
      "variant": "security"
    },
    {
      "id": "b-cite-detail",
      "from": "spring",
      "to": "web",
      "y": 1900,
      "label": "文件名 / 原文片段 / 页码",
      "variant": "return"
    },
    {
      "id": "b-download",
      "from": "web",
      "to": "spring",
      "y": 1965,
      "label": "15 GET 原文件",
      "variant": "default"
    },
    {
      "id": "b-storage",
      "from": "spring",
      "to": "files",
      "y": 2030,
      "label": "鉴权后读取原文件",
      "variant": "default",
      "note": "文件系统 API；不向浏览器公开存储路径"
    },
    {
      "id": "b-storage-bytes",
      "from": "files",
      "to": "spring",
      "label": "原文件字节",
      "variant": "return",
      "y": 2130
    },
    {
      "id": "b-download-bytes",
      "from": "spring",
      "to": "web",
      "y": 2195,
      "label": "HTTP 二进制下载",
      "variant": "return"
    },
    {
      "id": "b-stop",
      "from": "web",
      "to": "spring",
      "y": 2305,
      "label": "POST 停止生成",
      "variant": "security",
      "note": "也可由撤权、来源失效、30 秒无正文或 120 秒总长触发"
    },
    {
      "id": "b-run-fence",
      "from": "spring",
      "to": "db",
      "y": 2405,
      "label": "SQL 令旧 run 失效",
      "variant": "security",
      "note": "主动停止记 STOPPED；异常记 INCOMPLETE；仅末轮可手动重试"
    },
    {
      "id": "b-cancel",
      "from": "spring",
      "to": "fast",
      "y": 2505,
      "label": "HTTP cancel / 关闭流",
      "variant": "dashed"
    },
    {
      "id": "b-upstream-cancel",
      "from": "fast",
      "to": "models",
      "y": 2570,
      "label": "取消上游连接",
      "variant": "dashed",
      "note": "尽力释放资源；Spring 不依赖供应商确认来阻止旧结果"
    },
    {
      "id": "b-terminal",
      "from": "spring",
      "to": "web",
      "y": 2670,
      "label": "已停止 / 未完成 / 无权",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "权限与引用贯穿整条链路",
      "items": [
        "浏览器不能直接请求 FastAPI；kbId 来自 Spring 校验后的签名作用域",
        "pgvector 查询先过滤知识库与发布版本，再排序",
        "引用取真实文档定位；打开历史引用和下载时再次检查"
      ]
    },
    {
      "dot": "emerald",
      "title": "两套完成语义",
      "items": [
        "FastAPI done = 计算完成；Spring done = 引用验证与持久化完成",
        "流式片段按 runId/seq 管理，旧任务不能覆盖新回答",
        "资料不足是正常结果；服务错误、超时必须明确标记未完成"
      ]
    }
  ]
}
