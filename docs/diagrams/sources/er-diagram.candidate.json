  "cards": [
    {
      "dot": "cyan",
      "title": "先读关系，再看字段",
      "items": [
        "11张 core 表 + 1张 ai 表；View 是派生对象。",
        "PK/UK 可为联合键或部分索引，各标记列不必单独唯一。",
        "图按表对合并同类 FK；完整联合键与 NULL 规则见 database-design.md。",
        "messages.reply_to_message_id 自关联同会话 USER，最多一个 ASSISTANT；HTML 以字段标记说明，Mermaid 保留自关联线。"
      ]
    },
    {
      "dot": "amber",
      "title": "两组执行身份",
      "items": [
        "文件替换增加 document_version；手动重试增加 attempt_id。",
        "消息保存当前展示；generation_runs 记录每次执行。",
        "发布/当前执行指针的循环 FK 延迟到事务提交检查。"
      ]
    },
    {
      "dot": "emerald",
      "title": "检索和删除边界",
      "items": [
        "View 过滤 ACTIVE + PUBLISHED + 当前版本 + published_attempt。",
        "用户权限仍由 Spring 校验，FastAPI SQL 必须限定签名 kb_id。",
        "切片写入触发器拒绝过期/取消/删除后的旧执行；物理清理后不能复活。",
        "虚线是逻辑来源或 View 派生，不表示实际外键；向量维度不预先固定。"
      ]
    }
  ]
}
