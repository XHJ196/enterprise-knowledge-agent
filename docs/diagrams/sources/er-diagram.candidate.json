{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "企业知识平台 · 数据库 ER 图",
    "locale": "zh-CN",
    "output": "docs/diagrams/er-diagram.html",
    "quality_profile": "standard",
    "views": [
      {
        "id": "access",
        "label": "账号与知识库",
        "focus": [
          "users",
          "knowledge_bases",
          "kb_members",
          "documents",
          "conversations"
        ],
        "note": "创建关系与成员授权不同；kb_members 形成多对多。"
      },
      {
        "id": "publish",
        "label": "文件版本与条件发布",
        "focus": [
          "documents",
          "document_versions",
          "processing_jobs",
          "processing_attempts",
          "document_chunks",
          "retrievable_chunks"
        ],
        "note": "当前版本与发布 attempt 必须同时匹配；View 不替代请求授权。"
      },
      {
        "id": "chat",
        "label": "消息、执行与引用",
        "focus": [
          "conversations",
          "messages",
          "generation_runs",
          "citations",
          "document_chunks"
        ],
        "note": "重试保留消息对并新建 run；旧事件不能覆盖 current_run。"
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "entityW": 350,
    "headerH": 40,
    "rowH": 19,
    "gapX": 105,
    "gapY": 80
  },
