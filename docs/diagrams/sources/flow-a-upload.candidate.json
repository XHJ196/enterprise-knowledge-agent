{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "流程 A · 文档上传至可检索（设计时序）",
    "output": "diagrams/flow-a-upload.html",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "web",
      "type": "frontend",
      "label": "前端",
      "sublabel": "管理员上传 / 状态"
    },
    {
      "id": "spring",
      "type": "backend",
      "label": "Spring Boot",
      "sublabel": "鉴权 · 元数据 · 任务"
    },
    {
      "id": "files",
      "type": "database",
      "label": "文件存储",
      "sublabel": "仅 Spring 直接访问"
    },
    {
      "id": "fast",
      "type": "backend",
      "label": "FastAPI",
      "sublabel": "解析 · 切分 · 向量化"
    },
    {
      "id": "db",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "core / ai + pgvector"
    },
    {
      "id": "models",
      "type": "external",
      "label": "模型 API",
      "sublabel": "Embedding 服务"
    }
  ],
  "segments": [
    {
      "from": 155,
      "to": 835,
      "label": "A01—A04 接收文件，先保存任务，再异步派发"
    },
    {
      "from": 895,
      "to": 1540,
      "label": "A05—A07 内部取文件，解析切分并提交待发布向量"
    },
    {
      "from": 1600,
      "to": 2080,
      "label": "A08—A10 Spring 校验当前任务后发布，前端轮询结果"
    },
    {
      "from": 2140,
      "to": 2390,
      "label": "替代分支：解析失败或 300 秒超时，与成功路径互斥"
    }
  ],
  "messages": [
    {
      "id": "a-upload",
      "from": "web",
      "to": "spring",
      "y": 175,
      "label": "01 POST 上传文件",
      "variant": "emphasis",
      "note": "HTTP multipart；校验管理员、KB 状态、格式、大小和重名"
    },
    {
      "id": "a-store",
      "from": "spring",
      "to": "files",
      "y": 275,
      "label": "02 固定原文件",
      "variant": "default",
      "note": "文件系统 API；生成 storageKey，不使用任意用户路径"
    },
    {
      "id": "a-stored",
      "from": "files",
      "to": "spring",
      "y": 375,
      "label": "文件已落盘",
      "variant": "return"
    },
    {
      "id": "a-record",
      "from": "spring",
      "to": "db",
      "y": 440,
      "label": "03 SQL 写文档与任务",
      "variant": "default",
      "note": "同一事务：PROCESSING、version、attemptId、deadline=300 秒"
    },
    {
      "id": "a-commit",
      "from": "db",
      "to": "spring",
      "y": 540,
      "label": "事务提交",
      "variant": "return"
    },
    {
      "id": "a-accepted",
      "from": "spring",
      "to": "web",
      "y": 605,
      "label": "04 HTTP 202",
      "variant": "return",
      "note": "上传已接收，仍在处理中；不表示可以检索"
    },
    {
      "id": "a-dispatch",
      "from": "spring",
      "to": "fast",
      "y": 705,
      "label": "05 HTTP 提交任务",
      "variant": "dashed",
      "note": "持久化任务驱动；jobId/attemptId 去重；不是直接同步等待解析"
    },
    {
      "id": "a-task-ack",
      "from": "fast",
      "to": "spring",
      "y": 805,
      "label": "HTTP 202 接纳任务",
      "variant": "return"
    },
    {
      "id": "a-file-get",
      "from": "fast",
      "to": "spring",
      "y": 915,
      "label": "06 HTTP 取任务文件",
      "variant": "security",
      "note": "校验服务凭证、fileTicket、版本与期限；不自行判定员工权限"
    },
    {
      "id": "a-file-read",
      "from": "spring",
      "to": "files",
      "y": 1015,
      "label": "按 storageKey 读取",
      "variant": "default"
    },
    {
      "id": "a-file-bytes",
      "from": "files",
      "to": "spring",
      "y": 1080,
      "label": "文件字节",
      "variant": "return"
    },
    {
      "id": "a-file-response",
      "from": "spring",
      "to": "fast",
      "y": 1145,
      "label": "HTTP 文件流",
      "variant": "return",
      "note": "受控工作进程提取文字、PDF 页码，切分并保留定位"
    },
    {
      "id": "a-embed",
      "from": "fast",
      "to": "models",
      "y": 1245,
      "label": "07 HTTPS Embedding",
      "variant": "default",
      "note": "切片文字；指定固定的 embeddingModelId"
    },
    {
      "id": "a-embed-response",
      "from": "models",
      "to": "fast",
      "y": 1345,
      "label": "向量与维度",
      "variant": "return"
    },
    {
      "id": "a-stage",
      "from": "fast",
      "to": "db",
      "y": 1410,
      "label": "08 SQL 写待发布切片",
      "variant": "emphasis",
      "note": "按 version/attempt 隔离提交；此时检索视图仍不可见"
    },
    {
      "id": "a-staged",
      "from": "db",
      "to": "fast",
      "y": 1510,
      "label": "提交完成 / manifest",
      "variant": "return"
    },
    {
      "id": "a-callback",
      "from": "fast",
      "to": "spring",
      "y": 1620,
      "label": "09 HTTP 成功回调",
      "variant": "default",
      "note": "上报 attempt、version、chunkCount、manifest、modelId"
    },
    {
      "id": "a-publish",
      "from": "spring",
      "to": "db",
      "y": 1720,
      "label": "10 SQL 条件发布",
      "variant": "security",
      "note": "任务未超时且未被替换/删除；核对已提交切片后置 PUBLISHED"
    },
    {
      "id": "a-visible",
      "from": "db",
      "to": "spring",
      "y": 1820,
      "label": "发布事务提交",
      "variant": "return",
      "note": "检索视图只开放当前 publishedAttempt 的切片"
    },
    {
      "id": "a-callback-ack",
      "from": "spring",
      "to": "fast",
      "label": "HTTP 200 结果已接纳",
      "variant": "return",
      "y": 1920
    },
    {
      "id": "a-poll",
      "from": "web",
      "to": "spring",
      "y": 1985,
      "label": "11 GET 文档状态",
      "variant": "default"
    },
    {
      "id": "a-result",
      "from": "spring",
      "to": "web",
      "y": 2050,
      "label": "已发布 · 可以检索",
      "variant": "return"
    },
    {
      "id": "a-error",
      "from": "fast",
      "to": "spring",
      "y": 2160,
      "label": "HTTP FAILED / 取消",
      "variant": "dashed",
      "note": "解析失败由 Fast 上报；到 deadline 则由 Spring 主动判超时"
    },
    {
      "id": "a-fail-db",
      "from": "spring",
      "to": "db",
      "y": 2260,
      "label": "SQL 标记失败并失效尝试",
      "variant": "security",
      "note": "保留原文件；旧回调不得发布，手动重试产生新 attempt"
    },
    {
      "id": "a-fail-ui",
      "from": "spring",
      "to": "web",
      "y": 2360,
      "label": "状态查询返回处理失败",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "可检索的真正完成条件",
      "items": [
        "原文件保存 + 切片向量提交 + Spring 条件发布三者都完成",
        "FastAPI 不能直接写文档业务状态；202 只代表接收",
        "替换、超时和删除后，旧 attempt 的结果不得复活资料"
      ]
    },
    {
      "dot": "orange",
      "title": "异步与失败恢复",
      "items": [
        "任务在 Spring 的 PostgreSQL 表中持久化，不只保存在内存",
        "相同命令重复投递去重；失败任务仅管理员手动重试",
        "300 秒包含排队；物理时间不是本图的纵向比例"
      ]
    }
  ]
}
